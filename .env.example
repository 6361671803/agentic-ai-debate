# Choose the LLM backend: ollama (default, local/free), openai, gemini, or openrouter
LLM_PROVIDER=ollama

# ---- Ollama (local) ----
OLLAMA_MODEL=ollama/qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434

# ---- OpenAI (used when LLM_PROVIDER=openai) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Gemini (used when LLM_PROVIDER=gemini) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---- OpenRouter (used when LLM_PROVIDER=openrouter) ----
# Free tier, no billing required. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free

# ---- Tavily web search (optional) ----
# Used automatically as a fallback when DuckDuckGo search fails or returns
# nothing. Free tier, no billing required. Get a key at https://app.tavily.com
TAVILY_API_KEY=
